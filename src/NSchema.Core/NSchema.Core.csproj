<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>NSchema.Core</Title>
    <Description>The core engine for NSchema, a declarative database schema migration tool built for .NET</Description>
    <AssemblyName>NSchema.Core</AssemblyName>
    <RootNamespace>NSchema</RootNamespace>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>NSchema.Core</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>devops;cicd;build;automation;pipelines;databases;schema;rdbms;deployment;migration</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="/">
      <Link>CHANGELOG.md</Link>
    </None>
    <None Include="..\..\icon.png" Pack="true" PackagePath="/">
      <Link>icon.png</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NSchema.Diagnostics" />
    <Using Include="NSchema.Extensions" />
  </ItemGroup>

  <!--
    The architecture rules. OutputItemType="Analyzer" hands the built assembly to the compiler instead of linking against it;
    PrivateAssets keeps it out of the published package, which matters because this project packs.
  -->
  <ItemGroup>
    <ProjectReference Include="..\NSchema.Analyzers\NSchema.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

</Project>
