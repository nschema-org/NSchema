<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>NSchema</Title>
    <Description>A declarative database schema migration tool built for .NET</Description>
    <OutputType>Exe</OutputType>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nschema</ToolCommandName>
    <PackageId>NSchema</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>devops;cicd;build;automation;pipelines;databases;schema;rdbms;deployment;migration</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/">
      <Link>README.md</Link>
    </None>
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="/">
      <Link>CHANGELOG.md</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NSchema.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="editorconfig" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fully resolved: a path that keeps its '..' segments is re-relativised when this project is referenced
         from somewhere else, such as a generated host project in a temp directory. -->
    <ProjectReference Include="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../NSchema.Core/NSchema.Core.csproj'))" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NSchema.Diagnostics" />
    <Using Include="NSchema.Extensions" />
    <Using Include="NSchema.Services.Reporting" />
  </ItemGroup>

</Project>
